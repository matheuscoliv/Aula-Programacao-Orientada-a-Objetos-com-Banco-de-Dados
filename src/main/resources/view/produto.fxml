<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Produtos">
    <children>
        <VBox spacing="12" style="-fx-background-color: #112A4C; -fx-background-radius: 6;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <HBox alignment="CENTER" style="-fx-background-color: #0B1F3A; -fx-padding: 12; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label style="-fx-text-fill: #9FB0C0; -fx-font-size: 13px;" text="Sistema de Vendas — Cadastro de Produto" />
                    </children>
                </HBox>

                <VBox spacing="12" style="-fx-padding: 0 20 20 20;">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Nome" />
                        <TextField fx:id="campoNome" style="-fx-background-color: FFFFFF;" />

                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Preço" />
                        <TextField fx:id="campoPreco" style="-fx-background-color: FFFFFF;" />

                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Quantidade em estoque" />
                        <TextField fx:id="campoQuantidadeEstoque" style="-fx-background-color: FFFFFF;" />

                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;" VBox.vgrow="NEVER">
                            <children>
                                <Button onAction="#aoSalvar" mnemonicParsing="false" style="-fx-background-color: #0EA5C4; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 40; -fx-font-weight: bold;" text="Salvar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>